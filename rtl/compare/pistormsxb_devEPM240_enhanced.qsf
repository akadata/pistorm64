# Quartus II Settings File for Enhanced PiStorm CPLD with FC Support
# Project Name: pistormsxb_devEPM240_enhanced

set_global_assignment -name FAMILY "MAX II"
set_global_assignment -name DEVICE EPM240T100C5
set_global_assignment -name ORIGINAL_QUARTUS_FILE pistormsxb_devEPM240_enhanced.qpf
set_global_assignment -name PROJECT_CREATION_TIME_DATE "2023.01.01.00.00.00"
set_global_assignment -name LAST_QUARTUS_VERSION "20.1 Standard Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name DEVICE_FILTER_PIN_LEAKAGE ON
set_global_assignment -name DEVICE_FILTER_SPEED_GRADE 5
set_global_assignment -name DEVICE_FILTER_FAMILY "MAX II"
set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name GENERATE_SVF_FILE ON
set_global_assignment -name SMART_RECOMPILE ON

set_global_assignment -name VHDL_FILE amiga_enhanced_fc_pistorm.v
set_global_assignment -name TOP_LEVEL_ENTITY pistorm

# Pin assignments would go here in a real project
# For now, leaving as template

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top