    "/v1/a314/drives/{slot}/replace": {
      "post": {
        "tags": ["A314"],
        "operationId": "postA314DriveReplace",
        "summary": "Replace media in A314 slot",
        "parameters": [
          {
            "$ref": "#/components/parameters/A314Slot"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/A314MountRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Replaced",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/A314DriveState"
                }
              }
            }
          }
        }
      }
    },
    "/v1/a314/drives/{slot}/unmount": {
      "post": {
        "tags": ["A314"],
        "operationId": "postA314DriveUnmount",
        "summary": "Unmount/eject media from A314 slot",
        "parameters": [
          {
            "$ref": "#/components/parameters/A314Slot"
          }
        ],
        "responses": {
          "200": {
            "description": "Unmounted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/A314DriveState"
                }
              }
            }
          }
        }
      }
    },
    "/v1/a314/drives/{slot}/eject": {
      "post": {
        "tags": ["A314"],
        "operationId": "postA314DriveEject",
        "summary": "Eject media from A314 slot",
        "description": "Semantic alias for unmount; retained for UI clarity.",
        "parameters": [
          {
            "$ref": "#/components/parameters/A314Slot"
          }
        ],
        "responses": {
          "200": {
            "description": "Ejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/A314DriveState"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "PiScsiUnit": {
        "name": "unit",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "description": "PiSCSI unit number (maps to setvar piscsi0..piscsi6)"
      },
      "A314Slot": {
        "name": "slot",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "enum": ["pi0", "pd0", "pd1", "pd2", "pd3", "pd4"]
        },
        "description": "A314 drive slot (device names: pi0:, pd0:, pd1:, pd2:, pd3:, pd4:)"
      },
      "SetvarName": {
        "name": "name",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_\\-]+$"
        }
      },
      "RemoteProfileName": {
        "name": "name",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_\\-]+$"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "CommandAccepted": {
        "type": "object",
        "required": ["accepted", "commandId"],
        "properties": {
          "accepted": {
            "type": "boolean",
            "const": true
          },
          "commandId": {
            "type": "string"
          },
          "etaMs": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": ["ok", "service", "version", "time"],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SystemStatus": {
        "type": "object",
        "required": ["platform", "cpu", "rtg", "piscsi", "a314"],
        "properties": {
          "platform": {
            "type": "string"
          },
          "subsystem": {
            "type": "string"
          },
          "cpu": {
            "type": "string"
          },
          "jitEnabled": {
            "type": "boolean"
          },
          "rtg": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              },
              "ledsOverlay": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "piscsi": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "unitsMapped": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              }
            },
            "additionalProperties": false
          },
          "a314": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "drivesMounted": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "ResetRequest": {
        "type": "object",
        "required": ["mode"],
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["warm", "cold", "hard"]
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SetvarEntry": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SetvarValueRequest": {
        "type": "object",
        "required": ["value"],
        "properties": {
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "MapEntry": {
        "type": "object",
        "required": ["type", "address", "size"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["ram", "rom", "register"]
          },
          "address": {
            "type": "string",
            "pattern": "^0x[0-9A-Fa-f]+$"
          },
          "size": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "ovl": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "ConfigDocument": {
        "type": "object",
        "required": ["platform", "setvars", "maps"],
        "properties": {
          "sourcePath": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "subsystem": {
            "type": "string"
          },
          "cpu": {
            "type": "string"
          },
          "setvars": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SetvarEntry"
            }
          },
          "maps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MapEntry"
            }
          }
        },
        "additionalProperties": true
      },
      "ConfigValidateRequest": {
        "type": "object",
        "required": ["config"],
        "properties": {
          "config": {
            "$ref": "#/components/schemas/ConfigDocument"
          }
        },
        "additionalProperties": false
      },
      "ConfigValidateResponse": {
        "type": "object",
        "required": ["valid", "errors", "warnings"],
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "normalized": {
            "$ref": "#/components/schemas/ConfigDocument"
          }
        },
        "additionalProperties": false
      },
      "ConfigApplyRequest": {
        "type": "object",
        "required": ["config"],
        "properties": {
          "config": {
            "$ref": "#/components/schemas/ConfigDocument"
          },
          "writeToFile": {
            "type": "boolean",
            "default": true
          },
          "backup": {
            "type": "boolean",
            "default": true
          },
          "resetAfterApply": {
            "type": "boolean",
            "default": false
          },
          "resetMode": {
            "type": "string",
            "enum": ["warm", "cold", "hard"],
            "default": "warm"
          }
        },
        "additionalProperties": false
      },
      "KickstartProfile": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "a500_13",
              "a500_31",
              "a600_31",
              "a1200_31",
              "a3000_31",
              "a4000_31",
              "custom"
            ]
          },
          "label": {
            "type": "string"
          },
          "recommendedCpu": {
            "type": "string"
          },
          "defaultRomPath": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "KickstartState": {
        "type": "object",
        "required": ["profile"],
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/KickstartProfile"
          },
          "romPath": {
            "type": "string"
          },
          "checksum": {
            "type": "string"
          },
          "overlayAddress": {
            "type": "string",
            "pattern": "^0x[0-9A-Fa-f]+$"
          },
          "autodumpMem": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "KickstartUpdateRequest": {
        "type": "object",
        "properties": {
          "profileId": {
            "$ref": "#/components/schemas/KickstartProfile/properties/id"
          },
          "romPath": {
            "type": "string"
          },
          "overlayAddress": {
            "type": "string",
            "pattern": "^0x[0-9A-Fa-f]+$"
          },
          "autodumpMem": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "MediaImage": {
        "type": "object",
        "required": ["id", "name", "path", "kind", "sizeBytes"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["adf", "hdf", "img", "iso"]
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "readOnly": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "PiScsiSettings": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "controllerId": {
            "type": "integer",
            "const": 7
          },
          "ledsOverlay": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "PiScsiActivity": {
        "type": "object",
        "required": ["state"],
        "properties": {
          "state": {
            "type": "string",
            "enum": ["idle", "read", "write"]
          },
          "lastPulseMs": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "PiScsiUnitState": {
        "type": "object",
        "required": ["unit", "present"],
        "properties": {
          "unit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "present": {
            "type": "boolean"
          },
          "spec": {
            "type": "string",
            "description": "Original setvar-style spec"
          },
          "sourceType": {
            "type": "string",
            "enum": ["disk", "cdrom", "remote", "block"]
          },
          "backend": {
            "type": "string",
            "enum": ["file", "remote", "block"]
          },
          "readOnly": {
            "type": "boolean"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "blockSize": {
            "type": "integer",
            "minimum": 0
          },
          "activity": {
            "$ref": "#/components/schemas/PiScsiActivity"
          }
        },
        "additionalProperties": false
      },
      "RemoteEndpoint": {
        "type": "object",
        "required": ["host", "exportName"],
        "properties": {
          "token": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "default": 4964
          },
          "exportName": {
            "type": "string"
          },
          "tls": {
            "type": "boolean",
            "default": true
          }
        },
        "additionalProperties": false
      },
      "PiScsiMountRequest": {
        "type": "object",
        "required": ["sourceType"],
        "properties": {
          "sourceType": {
            "type": "string",
            "enum": ["disk", "cdrom", "remote", "block"]
          },
          "path": {
            "type": "string",
            "description": "Local path for disk/cdrom/block"
          },
          "mode": {
            "type": "string",
            "enum": ["ro", "rw"],
            "default": "rw"
          },
          "blockSize": {
            "type": "integer",
            "minimum": 512,
            "maximum": 65536
          },
          "remote": {
            "$ref": "#/components/schemas/RemoteEndpoint"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "sourceType": {
                  "const": "remote"
                }
              }
            },
            "then": {
              "required": ["remote"]
            }
          },
          {
            "if": {
              "properties": {
                "sourceType": {
                  "enum": ["disk", "cdrom", "block"]
                }
              }
            },
            "then": {
              "required": ["path"]
            }
          }
        ],
        "additionalProperties": false
      },
      "RemoteProfile": {
        "type": "object",
        "required": ["name", "endpoint"],
        "properties": {
          "name": {
            "type": "string"
          },
          "endpoint": {
            "$ref": "#/components/schemas/RemoteEndpoint"
          },
          "defaultMode": {
            "type": "string",
            "enum": ["ro", "rw"],
            "default": "ro"
          }
        },
        "additionalProperties": false
      },
      "RemoteProbeResult": {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "latencyMs": {
            "type": "number"
          },
          "message": {
            "type": "string"
          },
          "blockSize": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "A314AutoInsertEntry": {
        "type": "object",
        "required": ["unit", "filename", "rw"],
        "properties": {
          "unit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "filename": {
            "type": "string"
          },
          "rw": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "A314Config": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "a314ConfPath": {
            "type": "string"
          },
          "a314FsConfPath": {
            "type": "string"
          },
          "sharedPath": {
            "type": "string"
          },
          "diskConfPath": {
            "type": "string"
          },
          "autoInsert": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/A314AutoInsertEntry"
            }
          }
        },
        "additionalProperties": false
      },
      "A314DriveState": {
        "type": "object",
        "required": ["slot", "deviceName", "mounted"],
        "properties": {
          "slot": {
            "type": "string",
            "enum": ["pi0", "pd0", "pd1", "pd2", "pd3", "pd4"]
          },
          "deviceName": {
            "type": "string",
            "enum": ["pi0:", "pd0:", "pd1:", "pd2:", "pd3:", "pd4:"]
          },
          "mounted": {
            "type": "boolean"
          },
          "filename": {
            "type": "string"
          },
          "rw": {
            "type": "boolean"
          },
          "lastChange": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "A314MountRequest": {
        "type": "object",
        "required": ["filename"],
        "properties": {
          "filename": {
            "type": "string"
          },
          "rw": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      },
      "A314Status": {
        "type": "object",
        "required": ["enabled", "drives"],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "config": {
            "$ref": "#/components/schemas/A314Config"
          },
          "drives": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/A314DriveState"
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
