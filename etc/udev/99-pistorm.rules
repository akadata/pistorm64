# Allow non-root access to /dev/pistorm via group membership.
# Usage:
#   sudo groupadd -f pistorm
#   sudo usermod -aG pistorm <username>
# Then reload udev rules: sudo udevadm control --reload && sudo udevadm trigger
KERNEL=="pistorm", GROUP:="pistorm", MODE:="0660"
KERNEL=="z3bus", GROUP:="pistorm", MODE:="0660"

# net64 host backend: allow non-root access to TUN/TAP control node.
# /dev/net/tun is created from misc "tun".
KERNEL=="tun", GROUP:="pistorm", MODE:="0660"

# Optional: tag TAP interfaces to pistorm group ownership context.
# (Interface flags/bring-up/promisc still require CAP_NET_ADMIN.)
SUBSYSTEM=="net", KERNEL=="tap*", GROUP:="pistorm"

# Optional: allow non-root PiStorm64 users in group "pistorm" to access block media
# used as PiSCSI64 backends (disk:/dev/... and cdrom:/dev/...).
# This covers common Linux block node names:
#   /dev/sdX, /dev/sdXN, /dev/mmcblkN, /dev/mmcblkNpM, /dev/nvmeXnY, /dev/nvmeXnYpZ
SUBSYSTEM=="block", KERNEL=="sd[a-z]", GROUP:="pistorm", MODE:="0660"
SUBSYSTEM=="block", KERNEL=="sd[a-z][0-9]", GROUP:="pistorm", MODE:="0660"
SUBSYSTEM=="block", KERNEL=="mmcblk[0-9]", GROUP:="pistorm", MODE:="0660"
SUBSYSTEM=="block", KERNEL=="mmcblk[0-9]p[0-9]*", GROUP:="pistorm", MODE:="0660"
SUBSYSTEM=="block", KERNEL=="nvme[0-9]n[0-9]", GROUP:="pistorm", MODE:="0660"
SUBSYSTEM=="block", KERNEL=="nvme[0-9]n[0-9]p[0-9]*", GROUP:="pistorm", MODE:="0660"
